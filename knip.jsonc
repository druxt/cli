{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "test/**/*.test.ts"],
      "project": ["scripts/**/*.mjs", "test/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/bin.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
