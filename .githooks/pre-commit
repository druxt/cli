#!/usr/bin/env sh
# The fast half of CI: every linter, the type check, then the unit tests.
#
# The end-to-end test is not here. It downloads a real starter over the
# network, and a hook that needs the network gets bypassed with --no-verify.
set -e
npm run --silent lint
npm run --silent typecheck
# Git sets GIT_DIR and GIT_INDEX_FILE for a hook. The tests make repositories of
# their own, and with those set their commits would land in this one.
env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX npm test --silent
