{
  "name": "druxt-cli-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace for @druxt/cli, the Druxt command-line tool, and create-druxt.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/druxt/cli.git"
  },
  "type": "module",
  "workspaces": [
    "packages/cli",
    "packages/create-druxt"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "changeset": "changeset",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "npm run lint:js && npm run lint:format && npm run lint:md && npm run lint:cspell && npm run lint:private && npm run lint:attribution && npm run lint:knip",
    "lint:attribution": "bash .gitlab/scripts/check-attribution.sh",
    "lint:audit": "npm audit --omit=dev --audit-level=high",
    "lint:commit": "commitlint",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,mjs,ts,json,jsonc,md,yml,yaml}\"",
    "lint:format": "prettier --check \"**/*.{js,mjs,ts,json,jsonc,md,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"**/*.{js,mjs,ts,json,jsonc,md,yml,yaml}\"",
    "lint:js": "eslint .",
    "lint:knip": "knip --include dependencies,unlisted --no-config-hints",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:private": "node scripts/lint-private-refs.mjs",
    "lint:prose": "PROSE_LINT_GLOB='!.changeset/README.md' bash .gitlab/scripts/lint-prose.sh --all",
    "lint:prose:install": "bash .gitlab/scripts/install-vale.sh .vale/bin .vale/styles",
    "postinstall": "node scripts/postinstall.mjs",
    "release:check": "node scripts/release-check.mjs packages/cli packages/create-druxt",
    "release:version": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "test": "vitest run --coverage",
    "test:e2e": "DRX_E2E=1 vitest run packages/cli/test/e2e",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "10.5.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "knip": "6.45.1",
    "markdown-it": "14.3.3",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
